{
  "firestore": {
    "rules": "firestoreRules.txt"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.local"]
    }
  ],
  "hosting": {
    "source": ".",
    "site": "pluscoops",
    "frameworksBackend": {
      "region": "us-central1"
    },
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  }
}
