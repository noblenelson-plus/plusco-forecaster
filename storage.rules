rules_version = '2';

// Cloud Storage rules. Access checks read Firestore (cross-service rules) and
// mirror firestoreRules.txt / lib/format/access.ts — change them together.
//   - client-logos/: uploaded from the admin-only client drawer.
//   - reports/: the per-agency Reports snapshots published by the monthly sync
//     (scripts/lib/report-snapshot.mjs). Only the Admin SDK writes them.
service firebase.storage {
  match /b/{bucket}/o {
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function myDomain() {
      return myEmail().split('@')[1];
    }
    function userPath() {
      return /databases/(default)/documents/users/$(myEmail());
    }
    // Signed in with a verified email, has a users row (users/{email}), not
    // revoked.
    function isActive() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        firestore.exists(userPath()) &&
        firestore.get(userPath()).data.get('disabled', false) != true;
    }
    function isAdmin() {
      return isActive() && firestore.get(userPath()).data.role == 'ADMIN';
    }
    function dashboards() {
      return firestore.exists(/databases/(default)/documents/config/dashboard_access)
        ? firestore.get(/databases/(default)/documents/config/dashboard_access).data.get('dashboards', {})
        : {};
    }
    function grantedWith(id, mode) {
      let g = dashboards().get(id, {});
      return g.get('mode', 'AGENCY') == mode &&
        (myDomain() in g.get('domains', []) || myEmail() in g.get('users', []));
    }
    function dashCanReadAll() {
      return grantedWith('labs-pacing', 'GLOBAL') || grantedWith('exec-kpis', 'GLOBAL') ||
        grantedWith('mediaocean', 'GLOBAL') || grantedWith('mediabox', 'GLOBAL') ||
        grantedWith('reports', 'GLOBAL');
    }
    function dashAnyAgencyGrant() {
      return grantedWith('labs-pacing', 'AGENCY') || grantedWith('exec-kpis', 'AGENCY') ||
        grantedWith('mediaocean', 'AGENCY') || grantedWith('mediabox', 'AGENCY') ||
        grantedWith('reports', 'AGENCY');
    }
    // The caller's email domain maps to this agency, directly or via a
    // company-wide domain. Never the "_unassigned" bucket.
    function domainCoversAgency(agency) {
      return agency != '_unassigned' && (
        (firestore.exists(/databases/(default)/documents/config/company_domains) &&
          myDomain() in firestore.get(/databases/(default)/documents/config/company_domains)
            .data.get('domains', [])) ||
        (firestore.exists(/databases/(default)/documents/agencies/$(agency)) &&
          myDomain() in firestore.get(/databases/(default)/documents/agencies/$(agency))
            .data.get('domains', []))
      );
    }
    // Mirrors canReadAgencyData in firestoreRules.txt: admin → every agency;
    // a GLOBAL grant → every agency incl. "_unassigned"; an AGENCY grant → the
    // caller's agencies.
    function canReadAgency(agency) {
      return isAdmin() || (isActive() && (
        dashCanReadAll() || (dashAnyAgencyGrant() && domainCoversAgency(agency))
      ));
    }

    match /client-logos/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Which agencies exist per report table + the sync time. No row data.
    match /reports/manifest.json {
      allow read: if isActive();
      allow write: if false;
    }

    // One agency's rows: reports/{table}/{agency}/data.json.gz
    match /reports/{table}/{agency}/{fileName} {
      allow read: if canReadAgency(agency);
      allow write: if false;
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
