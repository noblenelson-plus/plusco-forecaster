rules_version = '2';

// Cloud Storage rules. Access checks read Firestore (cross-service rules) and
// mirror firestoreRules.txt / lib/format/access.ts — change them together.
//   - client-logos/: uploaded from the admin-only client drawer.
//   - reports/: the per-agency Reports snapshots published by the monthly sync
//     (scripts/lib/report-snapshot.mjs). Only the Admin SDK writes them.
service firebase.storage {
  match /b/{bucket}/o {
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function myDomain() {
      return myEmail().split('@')[1];
    }
    function userPath() {
      return /databases/(default)/documents/users/$(myEmail());
    }
    // A company email domain (config/sign_in_domains; see firestoreRules.txt).
    function signInAllowed() {
      return firestore.exists(/databases/(default)/documents/config/sign_in_domains) &&
        myDomain() in firestore.get(/databases/(default)/documents/config/sign_in_domains)
          .data.get('domains', []);
    }
    // Signed in with a verified company email, has a users row
    // (users/{email}), not revoked.
    function isActive() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        signInAllowed() &&
        firestore.exists(userPath()) &&
        firestore.get(userPath()).data.get('disabled', false) != true;
    }
    function isAdmin() {
      return isActive() && firestore.get(userPath()).data.role == 'ADMIN';
    }
    // The caller's grants (dashboard_grants/{email}; see firestoreRules.txt).
    function myGrantTabs() {
      return firestore.exists(/databases/(default)/documents/dashboard_grants/$(myEmail()))
        ? firestore.get(/databases/(default)/documents/dashboard_grants/$(myEmail())).data.get('tabs', {})
        : {};
    }
    function grantCoversAgency(tabs, id, agency) {
      return id in tabs &&
        (tabs[id].get('allAgencies', false) == true || agency in tabs[id].get('agencies', []));
    }
    function anyGrantCoversAgency(agency) {
      let t = myGrantTabs();
      return grantCoversAgency(t, 'forecaster', agency) || grantCoversAgency(t, 'labs-pacing', agency) ||
        grantCoversAgency(t, 'exec-kpis', agency) || grantCoversAgency(t, 'mediaocean', agency) ||
        grantCoversAgency(t, 'mediabox', agency) || grantCoversAgency(t, 'reports', agency);
    }
    function isCompanyDomain() {
      return firestore.exists(/databases/(default)/documents/config/company_domains) &&
        myDomain() in firestore.get(/databases/(default)/documents/config/company_domains)
          .data.get('domains', []);
    }
    // The email domain reads this agency: a company-wide domain → every one
    // ("_unassigned" included); else the agencies listing the domain.
    function domainCoversAgency(agency) {
      return isCompanyDomain() || (agency != '_unassigned' &&
        firestore.exists(/databases/(default)/documents/agencies/$(agency)) &&
        myDomain() in firestore.get(/databases/(default)/documents/agencies/$(agency))
          .data.get('domains', []));
    }
    // Mirrors canReadAgencyData in firestoreRules.txt: admin; the email
    // domain's agencies; any grant covering the agency.
    function canReadAgency(agency) {
      return isAdmin() || (isActive() && (domainCoversAgency(agency) || anyGrantCoversAgency(agency)));
    }

    match /client-logos/{fileName} {
      allow read: if isActive();
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Which agencies exist per report table + the sync time. No row data.
    match /reports/manifest.json {
      allow read: if isActive();
      allow write: if false;
    }

    // One agency's rows: reports/{table}/{agency}/data.json.gz
    match /reports/{table}/{agency}/{fileName} {
      allow read: if canReadAgency(agency);
      allow write: if false;
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
